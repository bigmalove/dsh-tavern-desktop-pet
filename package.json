{
  "name": "dsh-tavern-desktop-pet",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "DSH Tavern 桌宠插件：把 Live2D 桌宠（原 SillyTavern 扩展 tavern-desktop-pet）搬到 Tavern 里，跟着剧情吐槽、换表情、念台词；在卡片工作台里当建卡引导员。",
  "license": "CC-BY-NC-SA-4.0",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "client.js",
    "install.mjs",
    "README.md",
    "LICENSE",
    "assets"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-tavern",
    "tavern",
    "live2d",
    "desktop-pet"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "dsh-tavern-plugin",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.1",
      "dshTavern": ">=3.2.0",
      "dshReleases": {
        "0.2.1": "compatible"
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "install:tavern": "node install.mjs",
    "deploy": "node build.mjs && node install.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "klona": "2.0.6",
    "pinia": "^3.0.3",
    "sass": "^1.105.2",
    "vite": "^7.1.12",
    "vue": "^3.5.22",
    "zod": "^3.25.76"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bigmalove/dsh-tavern-desktop-pet.git"
  },
  "homepage": "https://github.com/bigmalove/dsh-tavern-desktop-pet#readme",
  "bugs": {
    "url": "https://github.com/bigmalove/dsh-tavern-desktop-pet/issues"
  }
}
